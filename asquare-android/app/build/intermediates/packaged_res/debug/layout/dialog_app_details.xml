<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_secondary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Close Button -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_secondary" />

        <!-- App Icon -->
        <ImageView
            android:id="@+id/ivDetailIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_card_cyber"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@android:drawable/sym_def_app_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- App Title -->
        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnClose"
            app:layout_constraintStart_toEndOf="@id/ivDetailIcon"
            app:layout_constraintTop_toTopOf="@id/ivDetailIcon"
            tools:text="Cyber Shield Pro" />

        <!-- Developer & Version -->
        <TextView
            android:id="@+id/tvDetailDev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/neon_cyan"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/btnClose"
            app:layout_constraintStart_toEndOf="@id/ivDetailIcon"
            app:layout_constraintTop_toBottomOf="@id/tvDetailTitle"
            tools:text="By ASquare Security Labs • v2.4.0" />

        <!-- Category & Rating -->
        <TextView
            android:id="@+id/tvDetailCategoryRating"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/btnClose"
            app:layout_constraintStart_toEndOf="@id/ivDetailIcon"
            app:layout_constraintTop_toBottomOf="@id/tvDetailDev"
            tools:text="Tools • ★ 4.9 (1,240 downloads)" />

        <!-- Hardware & ABI Compatibility Badge -->
        <TextView
            android:id="@+id/tvCompatibilityBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/ivDetailIcon"
            tools:text="✓ Verified Compatible with your device (arm64-v8a • Android 14)" />

        <!-- Big Install Button -->
        <Button
            android:id="@+id/btnDetailInstall"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_cyan"
            android:fontFamily="sans-serif-black"
            android:text="@string/btn_install"
            android:textAllCaps="false"
            android:textColor="@color/bg_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:layout_constraintTop_toBottomOf="@id/tvCompatibilityBadge" />

        <!-- Description Heading -->
        <TextView
            android:id="@+id/tvDescHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="About this Application"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btnDetailInstall" />

        <!-- Description Body -->
        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvDescHeading"
            tools:text="Complete next-generation security suite with hardware-accelerated packet inspection, encrypted tunneling, and active malware isolation." />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
